{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/waygl",
        "sources": "https://github.com/wired-tomato/WayGL"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "client": [
            {
                "value": "net.wiredtomato.waygl.FabricWayGL::onInitializeClient",
                "adapter": "kotlin"
            }
        ],
        "modmenu": [
            {
                "value": "net.wiredtomato.waygl.ModMenuIntegration",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=${flk_version}",
        "yet_another_config_lib_v3": ">=${yacl_version}",
        "minecraft": ">=${minecraft_version_major}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  